# syntax=docker/dockerfile:1
#
# Cross-compilation toolchain image for ssetunnel releases.
# Builds Linux (musl), Windows (mingw), and macOS (osxcross) binaries
# with CGO_ENABLED=1 so C libraries link correctly.
#
# Build:
#   docker build -t ssetunnel-cross .docker/
#
# macOS SDK (optional — skip to exclude darwin targets):
#   Place MacOSX*.sdk.tar.xz in .docker/ before building.
#   Extract from Xcode: https://github.com/phracker/MacOSX-SDKs

FROM golang:1.24-bookworm AS base

# ── musl cross-compilers (static Linux binaries) ──────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
      musl-tools \
      gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
      gcc-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*

# ── osxcross (macOS cross-compilation, optional) ──────────────────────
# Requires MacOSX*.sdk.tar.xz in the build context.
# If absent, osxcross is skipped and darwin targets won't build.
COPY . /sdk/
RUN apt-get update && apt-get install -y --no-install-recommends \
      clang llvm-dev libxml2-dev libssl-dev libbz2-dev liblzma-dev \
      git cmake patch xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 https://github.com/tpoechtrager/osxcross /opt/osxcross \
    && cd /opt/osxcross \
    && if ls /sdk/MacOSX*.sdk.tar.xz 1>/dev/null 2>&1; then \
         mv /sdk/MacOSX*.sdk.tar.xz /opt/osxcross/tarballs/ \
         && UNATTENDED=1 ./build.sh; \
       else \
         echo "No macOS SDK found — osxcross skipped (darwin targets disabled)"; \
       fi

ENV PATH="/usr/local/musl/bin:/usr/aarch64-linux-gnu/bin:${PATH}"

WORKDIR /src
